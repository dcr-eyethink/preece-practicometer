{
  "name": "preece-practicometer",
  "version": "1.0.0",
  "description": "Desktop metronome and practice tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build": "electron-builder --mac --win"
  },
  "build": {
    "appId": "org.eyethink.preece-practicometer",
    "productName": "Preece Practicometer",
    "files": [
      "main.js",
      "preload.js"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Preece Practicometer uses the microphone for the Ear Training pitch-matching feature."
      }
    },
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
